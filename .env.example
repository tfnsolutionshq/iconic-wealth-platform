# API base URL for the backend (Promise's team). Leave empty to use in-memory mock repositories.
# In development use `/api/v1` (Vite proxies it to the API below, avoiding CORS).
# VITE_API_BASE_URL=/api/v1
# The deployed API base URL is:
# VITE_API_BASE_URL=https://api.iconicwealth.tfnsolutions.us/api/v1
VITE_API_BASE_URL=
# Optional: call the live registration and sign-in API while the rest of the app stays on mock data.
# In development `/api/v1` is proxied by Vite to the API below.
# VITE_REGISTRATION_API_BASE_URL=/api/v1
# VITE_REGISTRATION_API_BASE_URL=https://api.iconicwealth.tfnsolutions.us/api/v1
VITE_REGISTRATION_API_BASE_URL=
# Paystack public key (pk_test_... in staging, pk_live_... in production)
VITE_PAYSTACK_PUBLIC_KEY=
# Demo mode: shows demo login accounts, Paystack outcome buttons, "Preview payout day" and the admin role switcher.
# MUST be false in production.
VITE_DEMO_MODE=true
# WhatsApp links supplied by the cooperative
VITE_WA_COMMUNITY_URL=https://chat.whatsapp.com/IconicWealthHubCommunity
VITE_WA_SUPPORT_URL=https://wa.me/2348000000000
